.env
venv/
.venv/
__pycache__/
*.pyc
.pytest_cache/
.git/
.vscode/
.idea/

# The frontend build runs `npm ci` inside the image, so a host node_modules is
# both useless and enormous -- and worse, it can carry native binaries built for
# the host OS into a Linux image. dist/ is rebuilt too; shipping a stale local
# copy would let a machine that never ran a build deploy whatever it last had.
frontend/node_modules/
frontend/dist/

# Local-only artefacts that have no business in an image.
data_lake/
*.parquet

# Media and docs. The repository carries an 18MB screen recording that the
# Dockerfile's `COPY . .` was pulling into the runtime image on every build.
*.mp4
*.mov
docs/

# Not needed at run time, and each one is a thing an attacker on a shell inside
# the container would otherwise get for free. terraform/ in particular describes
# the infrastructure the container is running on.
tests/
terraform/
.github/
