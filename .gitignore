# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/

# Frontend
node_modules/
frontend/dist/

# Generated data — the ETL rebuilds these; they are derived, not source.
data_lake/*.parquet

# Virtual Environment
venv/
.venv/

# Environment Variables (NEVER commit secrets)
.env

# Terraform. The state file is the record of what actually exists in AWS, and it
# stores resource attributes in the clear -- committing it publishes your
# infrastructure layout and can leak generated credentials. Keep it locally (or
# move it to a remote backend), never in git. Losing it means Terraform forgets
# what it built and will try to build a second copy.
terraform/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
!*.tfvars.example

# SSH private keys. The EC2 key pair downloads once and is often saved next to
# the project by accident; a committed private key is a public server.
*.pem
*.key
# ...but keep the marker that makes the certificate mount point exist.
!nginx/certs/.gitkeep

# Local database dumps kept beside the project on the server for a fast
# restore. Untracked files here are not harmless: anything git does not know
# about but a future commit might add is a file `git pull` refuses to
# overwrite, and on the deploy host that turns into a deploy which quietly
# builds the previous checkout.
backups/

# IDE
.vscode/
.idea/

# OS
Thumbs.db
.DS_Store

# ACME challenge files are transient; only the mount point is tracked.
nginx/certbot-webroot/*
!nginx/certbot-webroot/.gitkeep

# Written on the deploy host by the pipeline; it is a record of that host,
# not of the repository, and every host has its own.
.deploy-history

# The source catalogue export. 37 MB of third-party data that the repository
# does not need: scripts/recatalogue.py reads it once to produce
# docs/catalogue_products.csv and the thumbnails, and both of those ARE
# committed. Keep the original beside the project if you want to re-run it.
flipkart_com-ecommerce_sample.csv
