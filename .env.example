# ---------------------------------------------------------------------------
# Template for .env. Copy to `.env` and fill in real values:
#     cp .env.example .env
#
# Every variable below is REQUIRED. docker-compose.yml uses the ${VAR:?msg}
# form for secrets, so Compose aborts with a clear message rather than starting
# with a blank password if one is missing.
# ---------------------------------------------------------------------------

# Postgres superuser password. Provisions the `db` container on first start.
# IMPORTANT: this must match the password embedded in DATABASE_URL below.
# NOTE: POSTGRES_PASSWORD only takes effect when the data volume is empty.
# Changing it later requires `docker compose down -v` (destroys local data) or
# an ALTER USER inside the running database.
POSTGRES_PASSWORD=generate_a_strong_password_here

# How the API reaches Postgres and Redis. docker-compose.yml does NOT override
# these — .env is the single source of truth.
DATABASE_URL=postgresql://optistock:generate_a_strong_password_here@db:5432/optistock_db
REDIS_URL=redis://redis:6379/0

# Key used to sign JWTs. Must be long and random; the app will not start
# without it. Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=generate_a_very_secure_random_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Browser origins permitted to call this API. Never use ["*"] together with
# allow_credentials=True — browsers reject that combination outright.
ALLOWED_ORIGINS=["http://localhost:3000"]

# pgAdmin console login. Bound to 127.0.0.1 only; never expose this publicly.
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=generate_a_strong_password_here
